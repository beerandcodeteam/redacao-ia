# Copie para .env e preencha. O .env nunca é versionado (ver .gitignore).
# Valores com espaço precisam de aspas: os scripts .sh fazem `source` deste arquivo.
# Detalhes de cada serviço em docs/setup.md.

# --- Capa do post (generate-cover.sh) ---
# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Storage de capa e áudio (S3-compatible; aqui, OCI Object Storage) ---
# Customer Secret Key do usuário OCI (par access/secret da API S3-compat)
OCI_ACCESS_KEY_ID=
OCI_SECRET_ACCESS_KEY=
OCI_NAMESPACE=
OCI_REGION=
OCI_BUCKET=
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_ENDPOINT=
# base pública do bucket; o script concatena "/<object_key>"
OCI_URL=

# --- MCP do blog (mesmo token usado no header Authorization do .mcp.json) ---
BLOG_MCP_TOKEN=

# --- DataForSEO (painel seo-report; o MCP dfs-mcp usa as mesmas credenciais) ---
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=

# --- PageSpeed Insights (painel seo-report) ---
# Chave de API do Google Cloud restrita à PageSpeed Insights API
PAGESPEED_API_KEY=

# --- Google Analytics 4 (painel seo-report e skills de pauta) ---
# ID numérico da property (Admin > Property settings). Só o número; o script monta "properties/<id>".
GA4_PROPERTY_ID=
# Property do site principal, usada no funil blog -> site
GA4_SITE_PROPERTY_ID=

# --- Detector de news-jacking (detect.sh); todas opcionais ---
# Sem elas o detector roda só com as fontes abertas (HN, OpenRouter, GitHub, GDELT).
# PAT read-only: sobe o rate limit do GitHub de 60 para 5000 req/h
GITHUB_TOKEN=
# newsapi.org (free tier); vazio = cai para o GDELT
NEWSAPI_KEY=
# app em reddit.com/prefs/apps (OAuth client_credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="meu-blog-newsjack/1.0 by /u/seu_user"

# --- Painel SEO (opcionais) ---
# Diretório do app do blog, usado pelos insights de Core Web Vitals
# BLOG_V2_DIR=/caminho/para/o/app-do-blog
# SEO_PORT=8755
